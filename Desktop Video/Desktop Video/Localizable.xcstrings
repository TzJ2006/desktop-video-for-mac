    "PlaybackAutoDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal power: pause when all screens are covered. Low Power Mode: pause when any screen is covered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energía normal: pausa cuando todas las pantallas están cubiertas. Modo ahorro: pausa cuando cualquier pantalla está cubierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alimentation normale : pause quand tous les écrans sont couverts. Mode économie d'énergie : pause quand un écran est couvert."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正常电量下全部遮挡暂停，低电量模式下任意遮挡暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正常電量下全部遮擋暫停，低電量模式下任意遮擋暫停。"
          }
        }
      }
